<dialog x-data="lightbox" class="lightbox-container" aria-label="Image preview" @click.self="close"
    @cancel.prevent="close">
    <button type="button" class="lightbox-close" @click="close"
        aria-label="Close image preview">×</button>
    <div class="lightbox-loader" x-show="isLoading" role="status" aria-label="Loading image"></div>
    <img :src="imgSrc || null" :alt="imgAlt" class="lightbox-img" @load="isLoading = false"
        x-show="!isLoading">
</dialog>
