<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" <% if (!theme.favicon) { %>type="image/svg+xml" sizes="any"
    data-flux-favicon<% } %> href="<%= url_for(theme.favicon || '/images/flux-icon.svg') %>">
<%
    var resolvedPageTitle = page.title || '';
    if (!resolvedPageTitle && typeof is_category === 'function' && is_category() && page.category) {
        resolvedPageTitle = 'Category: ' + (page.category.name || page.category);
    }

    var pageTitle = (resolvedPageTitle ? resolvedPageTitle + ' | ' : '') + config.title + (config.subtitle ? ' ' + config.subtitle : ''),
        description = (page.project?.encrypted || page.encrypted || page.password) ? 'This content has been password protected.' : page.description || page.excerpt || page.project?.project_summary || page.content || config.description || '';
    if (description) {
        description = strip_html(description).substring(0, 200).replace(/^\s+|\s+$/g, '');
    }
    var metadataItem = page.project || page;
    var ogType = is_post() ? 'article' : 'website',
        ogImage = (page.project?.encrypted || page.encrypted || page.password) ? null : metadataItem.cover || metadataItem.image || theme.default_og_image;
%>
<title><%= pageTitle %></title>
<link rel="canonical" href="<%= flux_canonical() %>">
<script type="application/ld+json"
    data-flux-schema><%- flux_json(flux_schema(description, ogImage)) %></script>
<meta name="description" content="<%= description %>">
<meta property="og:type" content="<%= ogType %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:url" content="<%= flux_canonical() %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:locale" content="<%= config.language || 'en' %>">
<% if (ogImage) { %>
<meta property="og:image" content="<%= full_url_for(ogImage) %>">
<% } %>
<meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= description %>">
<% if (ogImage) { %>
<meta name="twitter:image" content="<%= full_url_for(ogImage) %>">
<% } %>
<%
  var palettes = palette_list ? palette_list() : [],
    pSelector = (theme.sidebar && theme.sidebar.palette_selector) ? theme.sidebar.palette_selector : {},
    defaultDark = pSelector.default_dark || 'solar-amber',
    defaultLight = pSelector.default_light || 'paper-and-ink';
%>
<script>
  (function() {
    // Configured defaults
    var defaultDark = '<%= defaultDark %>',
      defaultLight = '<%= defaultLight %>';

    // Determine preference
    var pref = 'auto';
    try {
      let hashget = new URLSearchParams(window.location.hash.substring(1) ?? '');
      pref = hashget.get('theme') || localStorage.getItem('flux-palette-theme') || 'auto';
    } catch (e) {}

    // Resolve 'auto' to actual palette key
    var key = pref;
    if (pref === 'auto') {
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        key = defaultDark;
      } else {
        key = defaultLight;
      }
    }

    // If custom, inject stored CSS immediately to prevent flash
    if (pref === 'custom') {
      try {
        var storedCss = localStorage.getItem('flux-palette-custom-css');
        if (storedCss) {
          document.documentElement.style.cssText = storedCss;
        }
      } catch (e) {}
    }

    // Apply
    document.documentElement.setAttribute('data-palette', String(key).replace(/[^a-zA-Z0-9_-]/g, ''));
  })();
</script>
<link rel="stylesheet" href="<%= url_for('/css/palettes.css') %>">
<link rel="stylesheet" href="<%= url_for('/css/base.css') %>">
<link rel="stylesheet" href="<%= url_for('/css/markdown.css') %>">
<link rel="stylesheet" href="<%= url_for('/css/features.css') %>">
<link rel="stylesheet" href="<%= url_for('/css/rich-content.css') %>">
<% if (flux_manifest().math) { %>
<link rel="stylesheet" data-flux-math href="<%= url_for('/css/vendor/katex.css') %>">
<% } %>
<% if (theme.print?.enabled !== false) { %>
<link rel="stylesheet" media="print" href="<%= url_for('/css/print.css') %>"><% } %>
<script defer src="<%= url_for('/js/runtime.js') %>"></script>
