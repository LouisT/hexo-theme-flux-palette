<% var homeMode = (theme.home && theme.home.mode) || 'blog'; %>

<%- partial('partial/curated') %>

<% if (homeMode === 'projects') { %>
<%- partial('partial/project-list', {projects: recent_projects(999999), title: theme.projects?.title || 'Projects'}) %>
<% } else { %>
<%- partial('partial/blog-list', {posts: page.posts, pagination: page, title: null}) %>
<% } %>
