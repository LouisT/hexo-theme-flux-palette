{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "includes": [
            "source/css/**/*.css"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "css": {
        "formatter": {
            "enabled": true,
            "quoteStyle": "double"
        }
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    }
}