# Copy to .env in the Hexo site root, beside _config.yml.
# Fill in only the provider you select in the site's _config.flux-palette.yml.
# Local search requires no environment variables.
# The theme's startup script loads the site's .env; shell/CI variables take precedence.
# Leave unused credentials blank. Never put actual secrets in this example file.

# Supabase (service: supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Turso libSQL (service: turso)
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
TURSO_READ_ONLY_TOKEN=

# Upstash Redis (service: upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_READ_ONLY_TOKEN=

# Upstash Search (service: upstash_search)
UPSTASH_SEARCH_REST_URL=https://your-search-database.upstash.io
UPSTASH_SEARCH_REST_TOKEN=
UPSTASH_SEARCH_READ_ONLY_TOKEN=

# Optional protected content: password: env:FLUX_POST_PASSWORD in front matter.
# You can add other named variables for posts/projects with separate passwords.
FLUX_POST_PASSWORD=

# Write tokens and post passwords stay in the build environment.
# Publishable keys and read-only tokens are included in the generated search UI.
