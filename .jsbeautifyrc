{
  "indent_size": 4,
  "indent_char": " ",
  "indent_with_tabs": false,
  "eol": "\n",
  "end_with_newline": true,
  "preserve_newlines": true,
  "max_preserve_newlines": 2,
  "wrap_line_length": 100,
  "wrap_attributes": "auto",
  "indent_inner_html": true,
  "templating": ["erb"],
  "content_unformatted": ["pre", "textarea", "script", "style"]
}
